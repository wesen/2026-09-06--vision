Subject: [PATCH 1/3] test(qwen3-vl-embedding): reproduce dropped video pixels

---
 .../tests/test_qwen3_vl_embedding_video.py    | 71 +++++++++++++++++++
 1 file changed, 71 insertions(+)
 create mode 100644 mlx_vlm/tests/test_qwen3_vl_embedding_video.py

diff --git a/mlx_vlm/tests/test_qwen3_vl_embedding_video.py b/mlx_vlm/tests/test_qwen3_vl_embedding_video.py
new file mode 100644
index 0000000..779bc45
--- /dev/null
+++ b/mlx_vlm/tests/test_qwen3_vl_embedding_video.py
@@ -0,0 +1,71 @@
+"""Regression tests for native video input to the embedding wrapper."""
+from types import SimpleNamespace
+from unittest.mock import Mock
+
+import mlx.core as mx
+import numpy as np
+import pytest
+
+from mlx_vlm.models.qwen3_vl_embedding.qwen3_vl_embedding import Model
+
+
+def test_public_call_forwards_video_pixels_to_hidden_state():
+    pixels = mx.ones((2, 12))
+    image_pixels = mx.zeros((1, 12))
+    grid = mx.array([[1, 2, 2]])
+    hidden = mx.ones((1, 2, 4))
+    capture = Mock(return_value=hidden)
+    wrapper = SimpleNamespace(_last_hidden_state=capture, normalize=True)
+
+    result = Model.__call__(
+        wrapper,
+        input_ids=mx.array([[1, 2]]),
+        attention_mask=mx.ones((1, 2)),
+        pixel_values=image_pixels,
+        pixel_values_videos=pixels,
+        image_grid_thw=grid,
+        video_grid_thw=grid,
+    )
+
+    assert capture.call_args.kwargs.get("pixel_values_videos") is pixels
+    assert capture.call_args.kwargs["pixel_values"] is image_pixels
+    assert capture.call_args.kwargs["video_grid_thw"] is grid
+    assert capture.call_args.kwargs["image_grid_thw"] is grid
+    np.testing.assert_allclose(np.array(result.text_embeds), [[0.5] * 4])
+
+
+def test_hidden_state_forwards_video_pixels_and_preserves_visual_features():
+    pixels = mx.ones((2, 12))
+    grid = mx.array([[1, 2, 2]])
+    positions = mx.zeros((3, 1, 2), dtype=mx.int32)
+    features = SimpleNamespace(
+        inputs_embeds=mx.ones((1, 2, 4)),
+        visual_pos_masks=mx.array([[True, False]]),
+        deepstack_visual_embeds=[mx.ones((1, 4))],
+        position_ids=positions,
+        rope_deltas=mx.zeros((1, 1)),
+    )
+    backbone = Mock(return_value=features)
+    decoder = Mock(return_value=mx.ones((1, 2, 4)))
+    language_model = SimpleNamespace(
+        _position_ids=None,
+        _rope_deltas=None,
+        get_rope_index=Mock(return_value=(positions, features.rope_deltas)),
+        model=decoder,
+    )
+    wrapper = SimpleNamespace(get_input_embeddings=backbone,
+                              language_model=language_model)
+
+    Model._last_hidden_state(
+        wrapper,
+        input_ids=mx.array([[1, 2]]),
+        attention_mask=mx.ones((1, 2)),
+        pixel_values_videos=pixels,
+        video_grid_thw=grid,
+    )
+
+    assert backbone.call_args.kwargs["pixel_values_videos"] is pixels
+    assert backbone.call_args.kwargs["video_grid_thw"] is grid
+    assert decoder.call_args.kwargs["visual_pos_masks"] is features.visual_pos_masks
+    assert decoder.call_args.kwargs["deepstack_visual_embeds"] is features.deepstack_visual_embeds
+    assert decoder.call_args.kwargs["cache"] is None
