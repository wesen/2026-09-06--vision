digraph pipeline { rankdir=TB; graph [bgcolor="white", pad="0.15", nodesep="0.3", ranksep="0.35"]; node [shape=box, fontname="Helvetica", fontsize=12, style="rounded", margin="0.13"]; edge [fontname="Helvetica", fontsize=10]; source [label="Registered video + hashes + source PTS"]; decode [label="Bounded source-frame decoding"]; full [label="Periodic full-scene evidence"]; detector [label="Detector -> stored boxes"]; tracks [label="Tracker -> observations and gaps"]; crops [label="Contextual crops + reversible transforms"]; proposals [label="Interaction proposals + budget policy"]; packet [label="Bounded evidence packet"]; vlm [label="VLM verifier / state recognizer"]; eval [label="Offline evaluator + reviewed labels", style="rounded,dashed"]; source -> decode; decode -> full; decode -> detector; detector -> tracks; tracks -> crops; tracks -> proposals; crops -> packet; proposals -> packet; full -> packet; packet -> vlm; vlm -> eval; }